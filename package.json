  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cc-switch",
    "ccswitch",
    "provider",
    "relay",
    "model-picker",
    "tui",
    "mouse"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/model-picker.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtshhhhh/Selkit.git"
  },
  "homepage": "https://github.com/xtshhhhh/Selkit#readme",
